{
  "name": "space-ex",
  "version": "1.0.0",
  "private": true,
  "description": "An interactive universe explorer and sky guide",
  "scripts": {
    "build:web": "node -e \"require('fs').mkdirSync('www',{recursive:true});for(const f of ['index.html','features.js','native-plugins.js','manifest.webmanifest','sw.js'])require('fs').copyFileSync(f,'www/'+f);require('fs').mkdirSync('www/icons',{recursive:true});require('fs').copyFileSync('icons/icon.svg','www/icons/icon.svg')\" && esbuild native-plugins.js --bundle --format=iife --outfile=www/native-plugins.js",
    "build:android": "npm run build:web && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/geolocation": "^7.1.5",
    "@capacitor-community/camera-preview": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "esbuild": "^0.25.5"
  }
}
